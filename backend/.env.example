# AlphaForge Configuration

# Local Database (auth tables only)
DATABASE_URL=postgresql+asyncpg://alphaforge:alphaforge@localhost:5434/alphaforge

# Redis
REDIS_URL=redis://localhost:6381/0

# JWT (auto-generated if empty, persisted in system_settings)
JWT_SECRET_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# StockPulse API (ALL ML data access)
STOCKPULSE_URL=http://localhost:8010
STOCKPULSE_API_KEY=

# NewsForge API (sentiment data)
NEWSFORGE_URL=http://localhost:8080
NEWSFORGE_API_KEY=

# AI Gateway
AI_GATEWAY_URL=http://localhost:8004

# Admin bootstrap
FIRST_ADMIN_EMAIL=

# ML Settings
PREDICTION_MIN_IC=0.01
PREDICTION_MIN_ICIR=0.1
ENSEMBLE_SIZE=5
WALKFORWARD_FOLDS=3
PREDICTION_HORIZONS=5

# RD-Agent
RDAGENT_CHAT_MODEL=gpt-4o-mini
RDAGENT_EMBED_MODEL=text-embedding-3-small

# Server
LOG_LEVEL=info
DEBUG=false
